function DrawApplyROI(file, chan, frame)

    if strcmp(file.drawROI, 'off')
        disp('Drawing ROI off')
    else
        Folder = dir(file.path);
        Folder(1:2) = [];
        idx = find([Folder.isdir] == 1);
        Name = Folder(idx).name;
    
        PositionPath = append(file.path, filesep, Name);
        PositionFolder = dir(PositionPath);
        for i = 3:size(PositionFolder, 1)
            Raw = load(append(PositionPath, filesep, PositionFolder(i).name, filesep, file.drawROI, '.mat'));
            ChName = fieldnames(Raw);
            Raw = Raw.(ChName{1});

            fig = figure();
            ChannelNames = fieldnames(chan);
            ChNames = {};
            for j = 1:size(ChannelNames, 1)
                if ~strcmp(chan.(ChannelNames{j, 1}), 'ignore')
                    ChNames{end+1,1} = chan.(ChannelNames{j, 1});
                end
            end
            for j = 1:size(ChNames, 1)
                DataPath = append(PositionPath, filesep, PositionFolder(i).name, filesep, ChNames{j,1}, '.mat');
                if exist(DataPath)
                    Raw = load(DataPath);
                    ChName = fieldnames(Raw);
                    Raw = Raw.(ChName{1});
                    subplot(1,size(ChNames, 1),j)
                    imagesc(Raw(:,:,frame))
                    colormap('hot')
                    axis image
                    title(ChNames{j,1})
                end
            end
            sgtitle(append(file.drawROI, ' - image ', num2str(i-2), ' out of ', num2str(size(PositionFolder, 1)-2)));

            SelectedAxis = subplot(1,size(ChNames, 1),find(strcmp(ChNames, file.drawROI)));
            axes(SelectedAxis);
            h = drawfreehand(SelectedAxis);
            mask(:,:,i-2) = createMask(h);
            close(fig)
        end
        
        l = waitbar(0, 'initializing');
        for i = 3:size(PositionFolder, 1)
            waitbar((i-2)./(size(PositionFolder, 1)-2), l, append('Applying ROI: image ', num2str(i-2), '/', num2str(size(PositionFolder, 1)-2)));
            ChannelNames = fieldnames(chan);
            for j = 1:size(ChannelNames, 1)
                DataPath = append(PositionPath, filesep, PositionFolder(i).name, filesep, chan.(ChannelNames{j}), '.mat');
                if exist(DataPath)
                    Raw = load(DataPath);
                    ChName = fieldnames(Raw);
                    Raw = Raw.(ChName{1});
                end
                for k = 1:size(Raw, 3)
                    Raw(:,:,k) = Raw(:,:,k) .* mask(:,:,i-2);
                end
                save(DataPath, "Raw");
            end
        end   
    end
end

